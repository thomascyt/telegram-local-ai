# Telegram bot token from @BotFather (REQUIRED)
TELEGRAM_BOT_TOKEN=123456:ABCdefGHIjklMNOpqrsTUVwxyz

# Comma-separated Telegram user IDs allowed to use the bot (REQUIRED for the bot to accept any messages)
TELEGRAM_ALLOWED_USER_IDS=123456789

# LLM API endpoint (Ollama OpenAI-compatible)
LLM_BASE_URL=http://127.0.0.1:11434/v1

# Optional overrides below
LLM_MODEL=smtek/Qwen3.8-27B:Q3_K_XL-16gb
# CONTEXT_LENGTH=8192
# MAX_TOKENS=4096
# TEMPERATURE=0.7
# THINKING_MODE=false
# INFERENCE_TIMEOUT=120
# HISTORY_LIMIT=12

# ── Web Search (Brave Search API) ─────────────────────────────────────
# Optional: enable web search for users.  Free tier = 1,000 queries/month.
# Requires a Brave Search API key from https://api.search.brave.com/
SEARCH_ENABLED=true
BRAVE_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXX
